# GitActionFlow — environment variable template
# Copy to `.env` for local development. Never commit real secrets.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8080
# Render injects PORT; the app prefers PORT over APP_PORT when both are set.
# PORT=
LOG_LEVEL=info
AUTO_MIGRATE=true

# Frontend origin used after OAuth redirect and for CORS (exact origin, no trailing slash)
FRONTEND_URL=http://localhost:5173
# Production example: FRONTEND_URL=https://your-app.vercel.app

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://gitactionflow:gitactionflow@localhost:5432/gitactionflow?sslmode=disable

# -----------------------------------------------------------------------------
# GitHub OAuth (required)
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:           http://localhost:5173
#   Authorization callback: http://localhost:8080/auth/github/callback
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8080/auth/github/callback
# Production (Vercel same-origin proxy): https://<your-vercel-domain>/auth/github/callback

# -----------------------------------------------------------------------------
# Sessions (required; >= 32 chars)
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
SESSION_SECRET=replace_with_a_secure_random_value_at_least_32_chars
SESSION_TTL=168h
OAUTH_STATE_TTL=10m

COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
# Production (Vercel ↔ Render): defaults become Secure=true and SameSite=None when APP_ENV=production

# -----------------------------------------------------------------------------
# GitHub webhooks (Phase 5 — required; >= 16 chars)
# Same secret must be configured on the GitHub repo webhook.
#   openssl rand -hex 32
# Payload URL (public): https://<your-host>/webhooks/github
# Local testing: use a tunnel (e.g. Cloudflare Tunnel / ngrok) to :8080
# Content type: application/json
# Events: Issues + Pull requests (at minimum)
# -----------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=replace_with_webhook_secret_at_least_16_chars
WEBHOOK_MAX_BODY_BYTES=1048576

# -----------------------------------------------------------------------------
# Event worker (Phase 6)
# -----------------------------------------------------------------------------
EVENT_WORKER_ENABLED=true
EVENT_WORKER_POLL_INTERVAL=2s
EVENT_MAX_RETRIES=3
EVENT_PROCESSING_LEASE=1m

# -----------------------------------------------------------------------------
# Actions (Phase 8)
# Slack Incoming Webhook URL is server-side only — never put it in rule config.
# -----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
ACTION_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Optional AI (stretch) — app starts and core path works with AI disabled
# -----------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GROQ_API_KEY=
# AI_API_KEY=

# -----------------------------------------------------------------------------
# Frontend (Vercel) — set in Vercel project env, not in backend .env
# -----------------------------------------------------------------------------
# Production (Vercel): leave unset for same-origin /api and /auth proxy to Render.
# VITE_API_BASE_URL=
