# GitActionFlow — environment variable template
# Copy to `.env` for local development. Never commit real secrets.
# All values below are placeholders / local-development examples.

# -----------------------------------------------------------------------------
# Application (Phase 2 — required for backend)
# -----------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info
# Apply SQL migrations on startup (default true in development/test)
AUTO_MIGRATE=true

# Public URLs (used by later phases for OAuth/webhooks)
APP_PUBLIC_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# PostgreSQL (Phase 2 — required)
# Local default matches docker-compose.yml postgres service credentials.
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://gitactionflow:gitactionflow@localhost:5432/gitactionflow?sslmode=disable

# -----------------------------------------------------------------------------
# GitHub OAuth — planned (Phase 3+)
# Create a GitHub OAuth App; callback path TBD
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8080/api/auth/github/callback

# -----------------------------------------------------------------------------
# GitHub webhooks — planned
# Shared secret used to verify X-Hub-Signature-256
# -----------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Slack — planned
# Incoming Webhook URL for the target channel (server-side only)
# -----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Session — planned
# Long random string used to sign/encrypt session cookies
# -----------------------------------------------------------------------------
SESSION_SECRET=

# -----------------------------------------------------------------------------
# Optional AI (stretch only) — leave empty; core app must work without these
# -----------------------------------------------------------------------------
# AI_PROVIDER=none
# AI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
