# GitActionFlow — environment variable template
# Copy to `.env` for local development. Never commit real secrets.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info
AUTO_MIGRATE=true

# Frontend origin used after OAuth redirect and for CORS
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://gitactionflow:gitactionflow@localhost:5432/gitactionflow?sslmode=disable

# -----------------------------------------------------------------------------
# GitHub OAuth (Phase 3 — required to start the backend)
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:           http://localhost:5173
#   Authorization callback: http://localhost:8080/auth/github/callback
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8080/auth/github/callback

# -----------------------------------------------------------------------------
# Sessions (Phase 3 — required; use a long random string, >= 32 chars)
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
SESSION_SECRET=replace_with_a_secure_random_value_at_least_32_chars
SESSION_TTL=168h
OAUTH_STATE_TTL=10m

# Cookie flags (local defaults: Secure=false, SameSite=Lax)
# Production should use COOKIE_SECURE=true (and SameSite=None only with HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# -----------------------------------------------------------------------------
# GitHub webhooks — planned (Phase 4+)
# -----------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Slack — planned
# -----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Optional AI (stretch only)
# -----------------------------------------------------------------------------
# AI_PROVIDER=none
# AI_API_KEY=
